# Supabase Configuration
# Masukkan credentials Supabase project Anda di .env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Go API and signaling endpoints
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws

# Local-only authentication escape hatch. Must also be enabled on the backend.
NEXT_PUBLIC_ALLOW_DEV_AUTH=false

# Optional authenticated private-channel fallback. The secure WebSocket is primary.
NEXT_PUBLIC_ENABLE_SUPABASE_SIGNALING_FALLBACK=false
